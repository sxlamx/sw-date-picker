{
  "name": "sw-date-picker",
  "version": "0.1.0",
  "description": "Dependency-free, accessible, locale-aware JavaScript date picker.",
  "type": "module",
  "main": "src/index.js",
  "module": "dist/sw-date-picker.js",
  "style": "dist/sw-date-picker.css",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/sw-date-picker.js",
      "default": "./src/index.js"
    },
    "./dist/sw-date-picker.css": "./dist/sw-date-picker.css"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "build": "esbuild src/index.js --bundle --format=esm --outfile=dist/sw-date-picker.js --minify --sourcemap",
    "build:iife": "esbuild src/index.js --bundle --format=iife --global-name=SwDatePicker --outfile=dist/sw-date-picker.iife.js --minify --sourcemap",
    "build:all": "npm run build && npm run build:iife"
  },
  "keywords": [
    "datepicker",
    "date-picker",
    "calendar",
    "accessible",
    "vanilla-js",
    "esm",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxlamx/sw-date-picker.git"
  },
  "bugs": {
    "url": "https://github.com/sxlamx/sw-date-picker/issues"
  },
  "homepage": "https://github.com/sxlamx/sw-date-picker#readme",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.0",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.0",
    "eslint": "^9.10.0",
    "happy-dom": "^20.10.3",
    "serve": "^14.2.6",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
