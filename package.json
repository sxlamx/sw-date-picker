{
  "name": "sw-date-picker",
  "version": "0.1.0",
  "description": "Dependency-free, accessible, locale-aware JavaScript date picker.",
  "type": "module",
  "main": "src/index.js",
  "module": "dist/sw-date-picker.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/sw-date-picker.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "build": "esbuild src/index.js --bundle --format=esm --outfile=dist/sw-date-picker.js --minify --sourcemap"
  },
  "keywords": [
    "datepicker",
    "date-picker",
    "calendar",
    "accessible",
    "vanilla-js",
    "esm",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxlamx/sw-date-picker.git"
  },
  "bugs": {
    "url": "https://github.com/sxlamx/sw-date-picker/issues"
  },
  "homepage": "https://github.com/sxlamx/sw-date-picker#readme",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.0",
    "@vitest/coverage-v8": "^2.1.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.10.0",
    "happy-dom": "^15.7.0",
    "serve": "^14.2.6",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
